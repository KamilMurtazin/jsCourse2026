{
    "name": "sd-js-course",
    "version": "1.0.0",
    "description": "JavaScript, Vue 3, Pinia and Vite course",
    "type": "module",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "scripts": {
        "watch": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "type-checker": "vue-tsc --noEmit --preserveWatchOutput",
        "lint": "oxlint --type-aware .",
        "lint:fix": "oxlint --type-aware --fix .",
        "test": "vitest run",
        "test-watch": "vitest",
        "update": "git fetch origin main && git merge origin/main"
    },
    "license": "ISC",
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@testing-library/dom": "10.4.1",
        "@testing-library/vue": "8.1.0",
        "@types/node": "26.4.1",
        "@vitejs/plugin-vue": "6.0.8",
        "@vue/compiler-dom": "3.5.42",
        "@vue/devtools-api": "8.2.1",
        "@vue/test-utils": "2.5.0",
        "jsdom": "30.0.1",
        "oxlint": "1.81.0",
        "oxlint-tsgolint": "7.0.2001",
        "pinia": "4.0.3",
        "sass-embedded": "1.104.0",
        "sinon": "22.1.0",
        "typescript": "5.9.3",
        "vite": "8.2.2",
        "vite-plugin-checker": "0.14.5",
        "vitest": "5.0.0",
        "vitest-fetch-mock": "0.4.5",
        "vue": "3.5.42",
        "vue-tsc": "3.3.11"
    },
    "dependencies": {
        "axios": "1.20.0",
        "highlight.js": "11.12.0",
        "marked": "18.0.11"
    }
}
